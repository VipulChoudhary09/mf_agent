# LiveKit project. Keep real values in .env.local or your deployment secret store.
LIVEKIT_URL=wss://your-project.livekit.cloud
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=
LIVEKIT_AGENT_NAME=mf-advisor

# Direct provider plugins
DEEPGRAM_API_KEY=
GOOGLE_API_KEY=
CARTESIA_API_KEY=

# Models
STT_MODEL=nova-3
STT_LANGUAGE=multi
STT_ENDPOINTING_MS=150
LLM_MODEL=gemini-2.5-flash-lite
TTS_MODEL=sonic-3
TTS_VOICE=79a125e8-cd45-4c13-8a67-188112f4dd22

# Runtime behavior
USE_RAG=true
AUTO_INDEX_KB=true
DELETE_ROOM_ON_CLOSE=true
LIVEKIT_METRICS_FILE=livekit_metrics.jsonl
